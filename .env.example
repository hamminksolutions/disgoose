# Copy to .env.local for local development (values from `npx supabase status`
# once `npx supabase start` is running).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Sentry (issue #35): DSN from the project's Client Keys settings. ORG/PROJECT/
# AUTH_TOKEN are optional, only used to upload source maps on build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
